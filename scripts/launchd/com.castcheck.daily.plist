<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.castcheck.daily</string>
  <key>ProgramArguments</key><array><string>/bin/zsh</string><string>/Users/zifanzhang/Documents/GitHub/castcheck/scripts/run_daily.sh</string></array>
  <key>StartCalendarInterval</key><array>
