.venv/
__pycache__/
*.pyc
.pytest_cache/
.cache/
public/
# raw/ holds logs and scratch; the run journal is the one file the status page needs, and it must
# survive between workflow runs, so it is committed (git cannot un-ignore a file inside an ignored
# directory, hence `data/raw/*` rather than `data/raw/`).
data/raw/*
!data/raw/last_run.json
*.grib2
*.nc
*.log
.env
.DS_Store

# internal planning docs (Chinese, contain personal context) stay local
docs/
.hf_README.md
.kaggle_stage/

# never commit half-written shards or wrangler caches
*.tmp.parquet
.*.tmp
.wrangler/

# macOS/iCloud conflict copies ("name 2.ext")
# any filename containing a space is a cloud-sync conflict copy — our real files never have spaces
* *
